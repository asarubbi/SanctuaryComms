<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <Frame name="SanctuaryCommsOptions" parent="UIParent" hidden="true" movable="true" enableMouse="true">
        <Size x="600" y="400"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Backdrop bgFile="Interface/Tooltips/UI-Tooltip-Background" edgeFile="Interface/DialogFrame/UI-DialogBox-Border" tile="true">
            <EdgeSize val="16"/>
            <TileSize val="16"/>
            <BackgroundInsets>
                <AbsInset left="8" right="8" top="8" bottom="8"/>
            </BackgroundInsets>
        </Backdrop>
        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentTitle" inherits="GameFontNormalLarge" text="SanctuaryComms Configuration">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="16" y="-16"/>
                    </Anchors>
                </FontString>
                <FontString name="$parentRulesLabel" inherits="GameFontHighlight" text="Rules (one per line, prefix ALLOW: or DENY:)">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="$parentDefaultAllowCB" relativePoint="BOTTOMLEFT" x="0" y="-32"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <CheckButton name="$parentDefaultAllowCB" inherits="InterfaceOptionsCheckButtonTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentTitle" relativePoint="BOTTOMLEFT" x="0" y="-16"/>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        _G[self:GetName().."Text"]:SetText("Default Allow")
                    </OnLoad>
                </Scripts>
            </CheckButton>
            <ScrollFrame name="$parentRulesScrollFrame" inherits="UIPanelScrollFrameTemplate">
                <Size x="560" y="240"/>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentRulesLabel" relativePoint="BOTTOMLEFT" x="0" y="-8"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        self:GetScrollChild():SetFocus()
                    </OnClick>
                </Scripts>
                <ScrollChild>
                    <EditBox name="$parentRulesEditBox" multiLine="true" autoFocus="false" enableMouse="true">
                        <Size x="560" y="240"/>
                        <Scripts>
                            <OnEscapePressed>
                                self:ClearFocus()
                            </OnEscapePressed>
                        </Scripts>
                    </EditBox>
                </ScrollChild>
            </ScrollFrame>
            <Button name="$parentCloseButton" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-5" y="-5"/>
                </Anchors>
            </Button>
        </Frames>
    </Frame>
</Ui>
